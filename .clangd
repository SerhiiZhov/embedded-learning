# clangd не понимает часть флагов компилятора ESP (gcc) — убираем их, чтобы подсказки работали.
CompileFlags:
  CompilationDatabase: build
  Remove:
    - -march=*
    - -mabi=*
    - -mcpu=*
    - -mtune=*
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce
